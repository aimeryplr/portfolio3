---
import {FontAwesomeIcon} from '@fortawesome/react-fontawesome';
import {faArrowLeft, faArrowUp} from "@fortawesome/free-solid-svg-icons";
import ErrorScreen from "../components/Dive/ErrorScreen.astro";
---

<ErrorScreen
    code={404}
    title="PAGE INTROUVABLE"
    subtitle="Vous êtes perdu dans l'océan"
    command="dive --to /404"
    error="erreur 404 : zone non cartographiée"
    depth="??.?"
    oceanDepth={0.5}
>
    <p>Cette page n'existe pas, ou elle a dérivé avec le courant. Pas de panique : on remonte doucement, sans sauter le palier.</p>
    <Fragment slot="actions">
        <a href="/" class="button button--primary">
            <FontAwesomeIcon icon={faArrowUp} className='w-3.5 h-3.5'/>
            Remonter à la surface
        </a>
        <button type="button" class="button button--outline" data-back>
            <FontAwesomeIcon icon={faArrowLeft} className='w-3.5 h-3.5'/>
            Page précédente
        </button>
    </Fragment>
</ErrorScreen>

<script>
    // the static page is served for every unknown path: show the one the visitor actually tried
    const prompt = document.querySelector("[data-command]");
    if (prompt) prompt.textContent = `aimery@portfolio:~$ dive --to ${location.pathname}`;

    const back = document.querySelector<HTMLButtonElement>("[data-back]")!;
    if (history.length > 1) back.addEventListener("click", () => history.back());
    else back.remove();
</script>
