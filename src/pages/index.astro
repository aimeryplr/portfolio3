---
import {FontAwesomeIcon} from '@fortawesome/react-fontawesome';
import {emptyCodingHoursProps} from "../components/CodingHours/props.ts";
import Image from "astro/components/Image.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import diverBackground from "../images/diver-background.png";
import CondingHours from "../components/CodingHours/CondingHours.astro";
import CodingHoursList from "../components/CodingHours/CodingHoursList.astro";
import WaveSvg from "../icons/wave.svg"
import {faArrowDown} from "@fortawesome/free-solid-svg-icons";
import {getCollection} from "astro:content";
import {ProjectType, ProjectTypeNames} from "../enum/projects.ts";
import type {Project} from "../types/project.schema.ts";
import ProjectPreview from '../components/Projects/ProjectPreview.tsx';
import ProjectNav from '../components/Projects/ProjectNav.tsx';
import Footer from '../components/Contact/Footer.astro';

const projects = await getCollection('projects');
projects.sort((a, b) => Object.values(ProjectType).findIndex((e => e === a.data.type)) - Object.values(ProjectType).findIndex((e => e === b.data.type)))
const slugify = (s: string) => s.toLowerCase().replace(/\s+/g, '-');
const allProjects = projects.map((p) => ({ id: slugify(p.id), name: p.data.name }));
---

<BaseLayout>
    <section class="relative w-full overflow-x-hidden">
        <Image class={"object-cover w-full h-svh opacity-80 max-w-none"} loading={'eager'} src={diverBackground}
               alt={'diver background'}/>
        <div class="absolute inset-20 flex justify-between">
            <div class="flex flex-col gap-4">
                <div>
                    <h1 class="text-2xl font-extrabold">DÉVELOPPEUR FULL STACK</h1>
                    <h2 class="text-xl font-bold">Aimery PELLERIN</h2>
                </div>
                <p class="w-120">Développer et relever des défis complexes en informatique me passionne. Chaque nouveau projet est une nouvelle opportunité pour apprendre et perfectionner mes compétences. Je me spécialise dans le développement Node.js, et plus particulièrement React / NestJS.</p>
                <p class="w-120">Le niveau 1 de plongée sous marine en poche, j'aimerais parcourir le dessous des océans partout dans le monde, ce portfolio est à cette image</p>
            </div>
            <div class="flex flex-col gap-4">
              <CondingHours server:defer>
                  <CodingHoursList codingHours={emptyCodingHoursProps} slot={'fallback'}/>
              </CondingHours>
            </div>
        </div>
        <div class="flex flex-col items-center gap-2 absolute bottom-1/3 left-1/2 -translate-x-1/2">
            <p class="text-xl font-bold">Projets</p>
            <FontAwesomeIcon icon={faArrowDown} className='w-6 h-6'/>
        </div>
        <WaveSvg class={"bottom-0 translate-y-[-99%] text-background w-full h-auto"}/>
    </section>
    <ProjectNav client:load projects={allProjects} />
    <section id="projects-section" class="flex flex-col gap-8 items-center pb-16">
      {Object.values(ProjectType).map((projectType) => {
        const filteredProjects = projects.filter((project) => project.data.type === projectType);
        const sectionTitle = ProjectTypeNames[projectType]

        return (
          <div class="w-260 flex flex-col gap-8">
            <h2 class="text-2xl font-bold">{sectionTitle}</h2>
            {filteredProjects.map((project) => (
              <div id={slugify(project.id)}>
                <ProjectPreview client:load project={{...project.data, preview: project.data.preview.src}} />
              </div>
            ))}
          </div>
        )
      })}
    </section>
    <Footer />
</BaseLayout>
