---
import {FontAwesomeIcon} from '@fortawesome/react-fontawesome';
import {Image} from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import {faArrowDown, faDownload} from "@fortawesome/free-solid-svg-icons";
import {faGithub, faLinkedinIn} from "@fortawesome/free-brands-svg-icons";
import {getCollection} from "astro:content";
import projectsData from "../data/projects.json";
import {ProjectType, ProjectTypeNames} from "../enum/projects.ts";
import ProjectPreview from '../components/Projects/ProjectPreview.tsx';
import Footer from '../components/Contact/Footer.astro';
import Ocean from '../components/Dive/Ocean.astro';
import DiveComputer from '../components/Dive/DiveComputer.astro';
import DiveColumn from '../components/Dive/DiveColumn.astro';
import HeroTitle from '../components/Dive/HeroTitle.astro';
import StopHead from '../components/Dive/StopHead.astro';

// The data store doesn't keep the file's order, so sort back to the order of projects.json
const projectOrder = projectsData.map((project) => project.id);
const projects = (await getCollection('projects'))
    .sort((a, b) => projectOrder.indexOf(a.id) - projectOrder.indexOf(b.id));
const slugify = (s: string) => s.toLowerCase().replace(/\s+/g, '-');
const projectTypes = Object.values(ProjectType);
---

<BaseLayout>
    <Ocean />
    <DiveColumn class="gap-[140px] pb-[140px]">
        <section class="flex min-h-[88svh] flex-col justify-center gap-[22px] pt-[60px] [&_p]:max-w-[60ch] [&_p]:opacity-92" data-stop="Surface">
            <HeroTitle title="DÉVELOPPEUR FULL STACK" name="Aimery PELLERIN"/>
            <p>Développer et relever des défis complexes en informatique me passionne. Chaque nouveau projet est une nouvelle opportunité pour apprendre et perfectionner mes compétences. Je me spécialise dans le développement Node.js, et plus particulièrement React / NestJS.</p>
            <p>Le niveau 1 de plongée sous marine en poche, j'aimerais parcourir le dessous des océans partout dans le monde, ce portfolio est à cette image.</p>
            <div class="flex flex-wrap gap-2.5">
                <a class="button button--primary" href="/aimery-pellerin-cv.pdf" download="Aimery-Pellerin-CV.pdf">
                    <FontAwesomeIcon icon={faDownload} className='w-3.5 h-3.5'/>
                    Télécharger mon CV
                </a>
                <a class="button button--primary button--icon-only" href="https://www.linkedin.com/in/aimery-pellerin-9a0596238" target="_blank" rel="noopener noreferrer me" aria-label="LinkedIn">
                    <FontAwesomeIcon icon={faLinkedinIn} className='w-4 h-4'/>
                </a>
                <a class="button button--primary button--icon-only" href="https://github.com/aimeryplr" target="_blank" rel="noopener noreferrer me" aria-label="GitHub">
                    <FontAwesomeIcon icon={faGithub} className='w-4 h-4'/>
                </a>
            </div>
            <div class="mt-[18px] flex items-center gap-2.5 font-mono text-[14px] text-muted">
                <FontAwesomeIcon icon={faArrowDown} className='w-3.5 h-3.5 animate-sink motion-reduce:animate-none'/>
                Projets
            </div>
        </section>

        {projectTypes.map((projectType) => {
            const filteredProjects = projects.filter((project) => project.data.type === projectType);
            const sectionTitle = ProjectTypeNames[projectType];
            // two columns from 810px; with an odd count the first card spans the full 888px column so no row is left half empty
            const isFeatured = (index: number) => index === 0 && filteredProjects.length % 2 === 1;
            const shotSizes = (index: number) => isFeatured(index)
                ? "(min-width: 920px) 842px, calc(100vw - 78px)"
                : "(min-width: 920px) 389px, (min-width: 810px) calc(50vw - 71px), calc(100vw - 78px)";

            return (
                <section class="flex flex-col gap-[22px]" data-stop={sectionTitle}>
                    <StopHead title={sectionTitle}/>
                    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,380px),1fr))] gap-[18px]">
                        {filteredProjects.map((project, index) => (
                            <div id={slugify(project.id)} class:list={["flex", isFeatured(index) && "col-span-full"]}>
                                <ProjectPreview project={project.data}>
                                    <Image slot="shot" class="absolute inset-0 size-full object-cover object-top" src={project.data.preview} alt={project.data.name}
                                           width={1920} widths={[480, 960, 1440, 1920]} quality={project.data.previewQuality}
                                           sizes={shotSizes(index)}/>
                                </ProjectPreview>
                            </div>
                        ))}
                    </div>
                </section>
            );
        })}
    </DiveColumn>
    <Footer />
    <DiveComputer />
</BaseLayout>
