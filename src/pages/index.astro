---
import {FontAwesomeIcon} from '@fortawesome/react-fontawesome';
import {getImage} from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import {faArrowDown} from "@fortawesome/free-solid-svg-icons";
import {getCollection} from "astro:content";
import {ProjectType, ProjectTypeNames} from "../enum/projects.ts";
import ProjectPreview from '../components/Projects/ProjectPreview.tsx';
import Footer from '../components/Contact/Footer.astro';
import Ocean from '../components/Dive/Ocean.astro';
import DiveComputer from '../components/Dive/DiveComputer.astro';

const projects = await getCollection('projects');
const slugify = (s: string) => s.toLowerCase().replace(/\s+/g, '-');
const projectTypes = Object.values(ProjectType);
// the 3300px source screenshots are far bigger than a card needs
const previews = Object.fromEntries(await Promise.all(projects.map(async (p) =>
  [p.id, (await getImage({src: p.data.preview, width: 1200, format: 'webp'})).src])));
---

<BaseLayout>
    <Ocean />
    <main class="dive-column">
        <section class="hero" data-stop="Surface">
            <div class="prompt">aimery@portfolio:~$ dive --max-depth 40m <span class="prompt-cursor"></span></div>
            <div>
                <h1>DÉVELOPPEUR FULL STACK</h1>
                <h2>Aimery PELLERIN</h2>
            </div>
            <p>Développer et relever des défis complexes en informatique me passionne. Chaque nouveau projet est une nouvelle opportunité pour apprendre et perfectionner mes compétences. Je me spécialise dans le développement Node.js, et plus particulièrement React / NestJS.</p>
            <p>Le niveau 1 de plongée sous marine en poche, j'aimerais parcourir le dessous des océans partout dans le monde, ce portfolio est à cette image</p>
            <div class="descend">
                <FontAwesomeIcon icon={faArrowDown} className='w-3.5 h-3.5'/>
                Projets
            </div>
        </section>

        {projectTypes.map((projectType) => {
            const filteredProjects = projects.filter((project) => project.data.type === projectType);
            const sectionTitle = ProjectTypeNames[projectType];

            return (
                <section class="stop" data-stop={sectionTitle}>
                    <div class="stop-head">
                        <h2>{sectionTitle}</h2>
                        <span class="eyebrow" data-depth-label></span>
                    </div>
                    <div class="stop-grid">
                        {filteredProjects.map((project) => (
                            <div id={slugify(project.id)} class="flex">
                                <ProjectPreview client:visible project={{...project.data, preview: previews[project.id]}}/>
                            </div>
                        ))}
                    </div>
                </section>
            );
        })}
    </main>
    <Footer />
    <DiveComputer />
</BaseLayout>
