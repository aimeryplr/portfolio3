---
import type {Project} from "../../types/project.schema.ts";
import Image from "astro/components/Image.astro";
import Wave1 from "../../icons/waves/Vector.svg"
import Wave2 from "../../icons/waves/Vector-1.svg"
import Wave3 from "../../icons/waves/Vector-2.svg"
import ProjectLink from "./ProjectLink.astro";
import {faCode, faGlobe} from "@fortawesome/free-solid-svg-icons";
import ProjectBadge from "./ProjectBadge.astro";
import LanguageIcon from "../LanguageIcon.astro";

interface Props {
  project: Project
}

const {project} = Astro.props;
console.log(project.technologies)
---

<div class="relative flex flex-col gap-4 bg-surface overflow-hidden px-8 py-6 w-full h-120 box-border rounded-2xl">
    <div class="flex justify-between">
        <div class="flex gap-2 items-center">
          <h3 class="text-xl font-bold">{project.name}</h3>
          {project.website && <ProjectLink aria-labe="website" icon={faGlobe} link={project.website} />}
          {project.code && <ProjectLink aria-labe="code" icon={faCode} link={project.code} />}
        </div>
        <div class="flex justify-end items-center gap-2">
          {project.technologies.map(tech => (
            <ProjectBadge>
                <LanguageIcon class="text-foreground w-7 h-7" technology={tech} />
            </ProjectBadge>
          ))}
        </div>
    </div>
    <Image class="relative z-1 object-contain w-full min-h-0" src={project.preview} alt={'project alt'}/>
    <Wave1 class="absolute left-0 bottom-0 w-full h-auto"/>
    <Wave2 class="absolute left-0 bottom-0 w-full h-auto"/>
    <Wave3 class="absolute left-0 bottom-0 w-full h-auto"/>
</div>
