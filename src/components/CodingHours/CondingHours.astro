---
import {fetchTSCodingHours} from "../../services/wakatime.ts";
import CodingHoursList from "./CodingHoursList.astro";
import {Technologies} from "../../enum/technologies.ts";
import type {ComponentProps} from "astro/types";

const TSCodingHours = await fetchTSCodingHours();

const codingHours: ComponentProps<typeof CodingHoursList>['codingHours'] = [
  {
    technology: Technologies.TYPESCRIPT,
    hours: TSCodingHours.hours,
    percent: TSCodingHours.percent
  },
  {
    technology: Technologies.REACT,
    hours: Math.round(TSCodingHours.hours * .62),
    percent: 62,
  },
  {
    technology: Technologies.NESTJS,
    hours: Math.round(TSCodingHours.hours * .23),
    percent: 32
  }
]
---

<CodingHoursList codingHours={codingHours}/>
