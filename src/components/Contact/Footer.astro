---
import ContactForm from "./ContactForm.tsx";
import { Card } from "@heroui/react/card";
import DiveColumn from "../Dive/DiveColumn.astro";
import StopHead from "../Dive/StopHead.astro";
---

<DiveColumn as="footer" class="gap-3.5 pt-10 pb-30" data-stop="Contact" data-seabed>
  <StopHead title="Me contacter" />
  <div class="font-mono text-[14px] tracking-[0.06em] text-accent opacity-85">Palier de sécurité · 5 m</div>
  <Card className="mt-3 max-w-136 items-center" data-card>
    <ContactForm client:visible />
  </Card>
</DiveColumn>
