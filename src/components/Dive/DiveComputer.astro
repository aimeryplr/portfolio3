---
// Dive computer HUD: pressure, depth, temperature, dive time, and a gauge listing every [data-stop] section, ridden by a tiny diver.

// the script rewrites each value, keeping the <small> unit
const readout = [
  { label: "PRESS", hud: "press", value: "1.0", unit: " bar" },
  { label: "PROF", hud: "depth", value: "0.0", unit: " m" },
  { label: "TEMP", hud: "temp", value: "26", unit: "°C" },
  { label: "DIVE", hud: "time", value: "00:00" },
];
---

<div class="pointer-events-none fixed top-1/2 right-[calc(18px+env(safe-area-inset-right,0px))] z-30 flex -translate-y-1/2 items-stretch gap-10 font-mono text-foreground max-[1400px]:top-auto max-[1400px]:bottom-[calc(14px+env(safe-area-inset-bottom,0px))] max-[1400px]:translate-y-0 max-md:hidden" id="dive-computer" role="complementary" aria-label="Ordinateur de plongée">
  <div class="-order-1 flex min-w-[92px] flex-col justify-center gap-2.5 text-right max-[1400px]:min-w-0 max-[1400px]:flex-row max-[1400px]:gap-3.5 max-[1400px]:rounded max-[1400px]:border max-[1400px]:bg-background/75 max-[1400px]:px-2.5 max-[1400px]:py-2 max-[1400px]:backdrop-blur-[8px]">
    {readout.map(({ label, hud, value, unit }) => (
      <div>
        <div class="text-[11px] tracking-[0.12em] text-muted">{label}</div>
        <div class="text-[22px] leading-none tabular-nums max-[1400px]:text-[16px] [&_small]:text-[13px] [&_small]:text-muted" {...{ [`data-hud-${hud}`]: true }}>{value}{unit && <small>{unit}</small>}</div>
      </div>
    ))}
  </div>
  <div class="relative pr-[150px] max-[1400px]:hidden"><div class="relative h-[46vh] w-0.5 bg-border" data-gauge><div class="absolute -left-[31px] h-[29px] w-16 -translate-y-1/2" data-marker>
        <svg class="size-full overflow-visible drop-shadow-[0_2px_5px_rgba(0,10,30,0.5)]" viewBox="-36 -16 72 32" aria-hidden="true" data-diver>
          <g class="origin-right [transform-box:fill-box]" data-fins>
            <polygon points="-25,-4 -35,-9 -31,-1" class="fill-accent" />
            <polygon points="-25,1 -31,-1 -34,6" class="fill-[color-mix(in_oklab,var(--accent)_65%,black)]" />
          </g>
          <polygon points="-25,-4 -13,-6 -13,3 -25,1" class="fill-[#8fb0c2]" />
          <polygon points="-13,-6 9,-7 13,-2 -13,-1" class="fill-[#cfe3ee]" />
          <polygon points="-13,-1 13,-2 10,4 -13,3" class="fill-[#8fb0c2]" />
          <polygon points="-11,-11 5,-11 8,-8 5,-6 -11,-6" class="fill-[#f5b942]" />
          <polygon points="9,1 18,5 16,8 7,4" class="fill-[#8fb0c2]" />
          <polygon points="13,-6 19,-7 22,-2 18,3 13,1" class="fill-[#cfe3ee]" />
          <polygon points="18,-5 23,-4 23,0 19,0" class="fill-accent" />
        </svg>
      </div></div></div>
</div>

<script>
  import { startDiveComputer } from "../../scripts/dive/diveComputer.ts";

  startDiveComputer(document.getElementById("dive-computer")!);
</script>

