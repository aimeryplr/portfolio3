---
// Full-screen error (404, 500) over the ocean, written like the hero: a failed command, a title, a way back up.
import BaseLayout from "../../layouts/BaseLayout.astro";
import Ocean from "./Ocean.astro";
import DiveColumn from "./DiveColumn.astro";
import HeroTitle from "./HeroTitle.astro";
import PromptCursor from "./PromptCursor.astro";

interface Props {
  code: number;
  title: string;
  subtitle: string;
  command: string;
  error: string;
  depth: string;
  // 0..1, where the water sits behind the message
  oceanDepth: number;
}

const { code, title, subtitle, command, error, depth, oceanDepth } = Astro.props;

const readout = [
  { label: "CODE", value: code },
  { label: "PROF", value: depth, unit: " m" },
  { label: "ACTION", value: "REMONTER" },
];
---

<BaseLayout title={`${code} · ${subtitle}`} noindex>
  <Ocean depth={oceanDepth} />
  <DiveColumn>
    <section class="flex min-h-svh flex-col justify-center gap-[22px] py-[60px] [&_p]:max-w-[60ch] [&_p]:opacity-92">
      <div class="flex flex-col gap-1 font-mono text-[15px] text-accent">
        <div data-command>aimery@portfolio:~$ {command}</div>
        <div class="text-warning">{error}</div>
        <div>aimery@portfolio:~$ <PromptCursor /></div>
      </div>
      <HeroTitle title={title} name={subtitle} />
      <slot />
      <div class="card card--default flex-row flex-wrap gap-7 self-start border px-[18px] py-3 font-mono">
        {readout.map(({ label, value, unit }) => (
          <div>
            <div class="text-[11px] tracking-[0.12em] text-muted">{label}</div>
            <div class="text-[22px] leading-none tabular-nums">{value}{unit && <small class="text-[13px] text-muted">{unit}</small>}</div>
          </div>
        ))}
      </div>
      <div class="mt-1.5 flex flex-wrap gap-3">
        <slot name="actions" />
      </div>
    </section>
  </DiveColumn>
</BaseLayout>

