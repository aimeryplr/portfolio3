---
// A section title, with the depth the dive computer writes beside it.
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="flex flex-wrap items-baseline gap-4">
  <h2 class="text-[28px] font-bold">{title}</h2>
  <span class="font-mono text-[14px] tracking-[0.06em] text-accent opacity-85" data-depth-label></span>
</div>
